# Unsplash API key — copy this file to .env and fill in your key.
# NEVER commit .env to version control.
#
# Obtain a free key at https://unsplash.com/developers
#
# The key is injected at build time via --dart-define:
#   flutter run --dart-define=UNSPLASH_ACCESS_KEY=your_key_here

UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
